    {
      "id": "insight",
      "html": "<div class='eb' style=\"font-family:var(--uip-font-body);text-transform:uppercase;letter-spacing:.2em;font-weight:700;font-size:24px;color:var(--uip-teal);margin-bottom:26px\">The insight</div><div class='hl' style=\"font-family:var(--uip-font-head);font-weight:700;font-size:90px;letter-spacing:-0.045em;color:var(--uip-white);line-height:1.03;max-width:1440px\">Merge is the moment of <span style=\"color:var(--uip-teal)\">maximum context.</span></div><p class='sub' style=\"font-family:var(--uip-font-body);font-size:33px;color:var(--uip-white);opacity:.72;margin-top:34px;max-width:1200px\">Everything the engineer knows — captured the instant it's freshest, before it evaporates.</p>",
      "css": ".w{display:inline-block}",
      "motionScript": "tl.from(root.querySelector('.eb'),{autoAlpha:0,y:16,duration:0.4},start+0.2);tl.from(root.querySelector('.hl'),{autoAlpha:0,y:36,duration:0.6,ease:'power3.out'},start+0.45);tl.from(root.querySelector('.sub'),{autoAlpha:0,y:20,duration:0.5,ease:'power2.out'},start+1.0);tl.to(root.querySelector('.hl span'),{textShadow:'0 0 30px rgba(11,162,179,.6)',duration:0.8,ease:'sine.inOut',repeat:3,yoyo:true},start+1.4);",
      "narration": "Here's the key insight. The moment a feature merges is the moment of maximum context. Everything the engineer knows is right there. So we capture it, before it evaporates.",
      "transitionOut": "tl.to(root,{scale:1.06,autoAlpha:0,duration:0.6,ease:\"power2.in\"},at)",
