      "motionScript": "tl.from(root.querySelectorAll('.hl5 .w'),{autoAlpha:0,y:40,rotateX:-60,duration:0.5,stagger:0.08,ease:'back.out(1.6)'},start+0.3);tl.from(root.querySelector('.mk.eng'),{autoAlpha:0,x:-40,duration:0.5,ease:'power2.out'},start+0.95);tl.from(root.querySelectorAll('.marr')[0],{autoAlpha:0,duration:0.3},start+1.4);tl.from(root.querySelector('.mk.art'),{autoAlpha:0,scale:0.68,duration:0.55,ease:'back.out(1.6)'},start+1.6);tl.from(root.querySelectorAll('.marr')[1],{autoAlpha:0,duration:0.3},start+2.05);tl.from(root.querySelector('.mk.sales'),{autoAlpha:0,x:40,duration:0.5,ease:'power2.out'},start+2.25);tl.to(root.querySelector('.mk.art'),{y:-12,duration:1.2,ease:'sine.inOut',repeat:3,yoyo:true},start+2.9);",
