      "css": ".gp{flex:1;background:rgba(255,255,255,.04);border:2px solid rgba(255,255,255,.12);border-top-width:5px;border-radius:18px;padding:36px 38px} .gp.eng{border-top-color:var(--uip-teal)} .gp.sales{border-top-color:var(--uip-orange)} .gp-ic{font-size:46px;margin-bottom:18px} .gp-t{font-family:var(--uip-font-head);font-weight:700;font-size:40px;color:var(--uip-white);margin-bottom:8px} .gp-s{font-family:var(--uip-font-body);font-size:28px;color:var(--uip-white);opacity:.6} .gapmid{flex:0 0 300px;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative} .gapline{width:100%;border-top:3px dashed var(--uip-white);opacity:.35} .gaplbl{position:absolute;top:22px;font-family:var(--uip-font-body);text-transform:uppercase;letter-spacing:.08em;font-size:19px;color:var(--uip-orange)}",
