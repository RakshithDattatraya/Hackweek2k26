      "html": "<div style='width:100%;display:flex;flex-direction:column;align-items:center;text-align:center'><div class='glow' style='position:absolute;width:900px;height:900px;border-radius:50%;background:radial-gradient(circle,rgba(250,70,22,.16),transparent 60%);filter:blur(20px);z-index:0'></div><img class='logo' src='assets/uipath-logo-orange.png' alt='UiPath' style='height:168px;width:auto;position:relative;z-index:1'/><div class='tag' style='font-family:var(--uip-font-head);font-weight:600;font-size:46px;color:var(--uip-white);margin-top:34px;position:relative;z-index:1'>Enablement<span style='color:var(--uip-orange)'>.</span> Automatically.</div></div>",
