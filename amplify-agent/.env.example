# Amplify coded agent — tenant config. Copy to .env and fill after `uipath auth`.
# NEVER commit a real .env. Folder scoping = tenant/customer isolation.
AMPLIFY_FOLDER_PATH=Shared
AMPLIFY_ENTITY=EnablementAsset
AMPLIFY_RENDER_PROCESS=amplify-render
# Use a Claude model id from `uipath list-models` (e.g. anthropic.claude-sonnet-4-5):
# sonnet-5 / opus-4.7/4.8 reject 'temperature' (SDK sends it) -> 400; use 4-6/4-5:
AMPLIFY_LLM_MODEL=anthropic.claude-sonnet-4-6
# Integration Service connection keys (from the connections you create):
AMPLIFY_GITHUB_CONNECTION=
AMPLIFY_JIRA_CONNECTION=
