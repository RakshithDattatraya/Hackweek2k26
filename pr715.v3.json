{
  "feature_name": "FinS Loan-Config Admin Experience",
  "value_prop": "An in-solution, no-code flow that turns a lender's written credit policy into a governed, executable FEEL decision model — the admin reviews an agent-drafted model against the source document, validates the taxonomy, and publishes.",
  "persona": "FINS solution admins and delivery / SE teams configuring a lender's credit policy",
  "when_to_use": "When onboarding a new lender's credit policy, or when a policy changes — anytime a written credit policy needs to become governed, automated loan decisions.",
  "talking_points": [
    "Turns a written credit policy into a governed, executable decision model — no code, no FINSRule.",
    "Guided end-to-end flow: create config, upload policy, confirm sources, generate rules, review, taxonomy, publish.",
    "An agent drafts a first-pass decision model (rule groups + conditions); the admin reviews it beside the source document.",
    "Manage mode allows post-publish edits with a change log and undo; the config is stamped with its DecisionModelId.",
    "Runs in-solution (no separate API); the taxonomy passes a scored, gated validation before publish."
  ],
  "objections": [
    {
      "q": "Does the agent replace the reviewer?",
      "a": "No — the agent drafts a first-pass decision model; the admin confirms, edits, reorders, adds, or deletes rules against the source policy document. It's human-governed."
    },
    {
      "q": "What happens when the policy changes?",
      "a": "Manage mode supports post-publish edits with a full change log and undo, and you re-publish a new version. The config always points at its current DecisionModelId."
    },
    {
      "q": "Is this just rules in code again?",
      "a": "No — FINSRule is retired. The canonical artifact is a FEEL decision model resolved by FINSConfig.DecisionModelId, authored with no code."
    }
  ],
  "music_mood": "corporate",
